generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql" 
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MasteryLevel {
  UNKNOWN      // 未チェック
  LOW          // 理解が曖昧
  HIGH         // 習得済み
}

enum ProblemSource {
  SYSTEM   // アプリ既存
  USER     // ユーザー作成
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  progress      UserProblemProgress[]
  functionStats UserFunctionMastery[]
  createdProblems Problem[] @relation("UserCreatedProblems")
}

model Function {
  id          String   @id @default(cuid())
  key         String   @unique // Math.max, Array.map など
  categoryKey String
  createdAt   DateTime @default(now())

  problems    ProblemFunction[]
  mastery     UserFunctionMastery[]
}

model UserFunctionMastery {
  id          String        @id @default(cuid())
  userId      String
  functionId  String
  mastery     MasteryLevel
  updatedAt   DateTime      @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  function    Function @relation(fields: [functionId], references: [id])

  @@unique([userId, functionId])
}

model Problem {
  id            String        @id @default(cuid())
  title         String
  description   String
  difficulty    Difficulty
  source        ProblemSource
  creatorId     String?
  staticKey     String?       // system問題の場合にJSONと紐づけ
  createdAt     DateTime      @default(now())

  creator       User? @relation("UserCreatedProblems", fields: [creatorId], references: [id])
  functions     ProblemFunction[]
  testCases     TestCase[]
  progress      UserProblemProgress[]
}

model ProblemFunction {
  problemId   String
  functionId  String

  problem     Problem  @relation(fields: [problemId], references: [id])
  function    Function @relation(fields: [functionId], references: [id])

  @@id([problemId, functionId])
}

model TestCase {
  id         String   @id @default(cuid())
  problemId  String
  input      String
  output     String
  createdAt DateTime @default(now())

  problem    Problem @relation(fields: [problemId], references: [id])
}

model UserProblemProgress {
  id         String     @id @default(cuid())
  userId     String
  problemId  String
  solved     Boolean
  lastTriedAt DateTime @updatedAt

  user       User    @relation(fields: [userId], references: [id])
  problem    Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}
