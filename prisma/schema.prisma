generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql" 
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ユーザー
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  knowledgeStatus    KnowledgeStatus[]
  problemAttempts    ProblemAttempt[]
  createdProblems    Problem[]
  achievementRecords AchievementRecord[]

  @@index([email])
}

// カテゴリー（Math.max等の関数・処理ごと）
model Category {
  id          String   @id @default(cuid())
  name        String   @unique // "Math.max", "Array.prototype.map" など
  displayName String   // 表示用
  description String   @db.Text
  order       Int      @default(0) // 表示順
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems        Problem[]
  knowledgeStatus KnowledgeStatus[]
  tags            Tag[]

  @@index([order])
}

// タグ（使用している技術/関数）
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  problems   Problem[]
  categories Category[]

  @@index([name])
}

// 問題
model Problem {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  difficulty  DifficultyLevel
  categoryId  String
  createdBy   String?        // ユーザー作成問題の場合
  isOfficial  Boolean        @default(true) // 公式問題かユーザー作成か
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // 問題の詳細
  explanation      String         @db.Text // 解説
  sampleInput      String         @db.Text // サンプル入力
  sampleOutput     String         @db.Text // サンプル出力
  constraints      String?        @db.Text // 制約条件
  timeLimit        Int            @default(2000) // ms
  memoryLimit      Int            @default(256) // MB

  // リレーション
  category        Category          @relation(fields: [categoryId], references: [id])
  creator         User?             @relation(fields: [createdBy], references: [id])
  testCases       TestCase[]
  attempts        ProblemAttempt[]
  tags            Tag[]
  relatedProblems ProblemRelation[] @relation("SourceProblem")
  relatedTo       ProblemRelation[] @relation("TargetProblem")

  @@index([categoryId])
  @@index([difficulty])
  @@index([createdBy])
  @@index([isOfficial])
}

// テストケース
model TestCase {
  id        String   @id @default(cuid())
  problemId String
  input     String   @db.Text
  output    String   @db.Text
  isHidden  Boolean  @default(false) // 非表示テストケース
  order     Int      @default(0)
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([order])
}

// 問題間の関連（おすすめ問題のため）
model ProblemRelation {
  id            String   @id @default(cuid())
  sourceProbId  String
  targetProbId  String
  relationType  String   // "next", "similar", "prerequisite"
  weight        Float    @default(1.0) // おすすめ度
  createdAt     DateTime @default(now())

  sourceProblem Problem @relation("SourceProblem", fields: [sourceProbId], references: [id], onDelete: Cascade)
  targetProblem Problem @relation("TargetProblem", fields: [targetProbId], references: [id], onDelete: Cascade)

  @@unique([sourceProbId, targetProbId])
  @@index([sourceProbId])
  @@index([targetProbId])
}

// 知識状態（各カテゴリーに対するユーザーの理解度）
model KnowledgeStatus {
  id         String          @id @default(cuid())
  userId     String
  categoryId String
  status     KnowledgeLevel
  updatedAt  DateTime        @updatedAt
  createdAt  DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@index([status])
}

// 問題への挑戦記録
model ProblemAttempt {
  id         String        @id @default(cuid())
  userId     String
  problemId  String
  code       String        @db.Text
  result     AttemptResult
  executionTime Int?       // ms
  createdAt  DateTime      @default(now())
  
  // エラー情報
  errorMessage String?     @db.Text
  failedTestCase Int?      // 失敗したテストケース番号

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([result])
  @@index([createdAt])
}

// 達成度記録（二種類の達成度管理）
model AchievementRecord {
  id                    String   @id @default(cuid())
  userId                String
  date                  DateTime @default(now())
  
  // 理解度が高い項目数
  masteredCount         Int      @default(0)
  
  // 理解度が曖昧な項目数
  uncertainCount        Int      @default(0)
  
  // 解いた問題数
  solvedProblemsCount   Int      @default(0)
  
  // 連続ログイン日数
  streakDays            Int      @default(0)

  // リレーション
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

enum DifficultyLevel {
  BEGINNER    // 初級
  EASY        // 簡単
  MEDIUM      // 中級
  HARD        // 難しい
  EXPERT      // 上級
}

enum KnowledgeLevel {
  UNKNOWN     // 知らない
  LEARNING    // 学習中
  UNCERTAIN   // 理解度が曖昧
  MASTERED    // 習得済み
}

enum AttemptResult {
  ACCEPTED            // 正解
  WRONG_ANSWER        // 不正解
  TIME_LIMIT_EXCEEDED // 時間制限超過
  RUNTIME_ERROR       // 実行時エラー
  COMPILE_ERROR       // コンパイルエラー（構文エラー）
}